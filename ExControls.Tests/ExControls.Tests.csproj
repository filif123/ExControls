<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<!-- kniznica sa publikuje aj pre .NET Framework - testy overuju oba ciele -->
		<TargetFrameworks>net48;net10.0-windows</TargetFrameworks>
		<RootNamespace>ExControls.Tests</RootNamespace>
		<AssemblyName>ExControls.Tests</AssemblyName>
		<IsPackable>false</IsPackable>
		<UseWindowsForms>true</UseWindowsForms>
		<LangVersion>latest</LangVersion>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
		<PackageReference Include="MSTest.TestAdapter" Version="4.4.0" />
		<PackageReference Include="MSTest.TestFramework" Version="4.4.0" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\ExControls\ExControls.csproj" />
	</ItemGroup>
	<ItemGroup>
		<Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
	</ItemGroup>
</Project>
