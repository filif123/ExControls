<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0-windows</TargetFramework>
		<OutputType>WinExe</OutputType>
		<RootNamespace>ExControls.Test</RootNamespace>
		<AssemblyName>ExControls.Test</AssemblyName>
		<UseWindowsForms>true</UseWindowsForms>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<LangVersion>default</LangVersion>
	</PropertyGroup>
	<ItemGroup>
		<ProjectReference Include="..\ExControls\ExControls.csproj" />
	</ItemGroup>
	<!-- rozpracovane okno s vlastnym zahlavim - len archiv, nekompiluje sa (pozri WorkInProgress/README.md) -->
	<ItemGroup>
		<Compile Remove="WorkInProgress\**" />
		<EmbeddedResource Remove="WorkInProgress\**" />
		<None Include="WorkInProgress\**" />
	</ItemGroup>
	<!-- ExControls designer extension for VS (collection editor of ExOptionsView.Panels) -->
	<Import Project="..\ExControls.Designer.targets" />
</Project>
